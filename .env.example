# Local development only. In production on Cloud Run, GEMINI_API_KEY is
# injected from Secret Manager via --set-secrets and this file is never used.

# Gemini API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# GCP project id (needed for firebase-admin's applicationDefault credentials
# when running locally with `gcloud auth application-default login`)
GCLOUD_PROJECT=your-gcp-project-id

PORT=8080
